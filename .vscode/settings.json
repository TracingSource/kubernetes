{
    "go.toolsEnvVars": {
        "GOPATH": "/usr/local/gopath",
        "GOPROXY": "https://goproxy.cn",
        "GO111MODULE": "auto"
    },
    // 左侧浏览器中不展示如下路径的内容
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,

        "**/BUILD": true,
        "**/OWNERS": true,
        "**/*.bzl": true,
        "cmd/cloud-controller-manager/": true,
        "cmd/kubemark/": true,
        "cmd/gendocs/": true,
        "cmd/genkubedocs/": true,
        "cmd/genman/": true,
        "cmd/genswaggertypedocs/": true,
        "cmd/genutils/": true,
        "cmd/genyaml/": true,
        "pkg/cloudprovider/": true,
        "pkg/kubemark/": true,
        "pkg/credentialprovider/aws": true,
        "pkg/credentialprovider/azure": true,
        "pkg/credentialprovider/gcp": true,
        "pkg/volume/cinder/": true,
        "pkg/volume/git_repo/": true,
        "pkg/volume/awsebs/": true,
        "pkg/volume/azure_dd/": true,
        "pkg/volume/azure_file/": true,
        "pkg/volume/gcepd/": true,
        "pkg/volume/rbd/": true,
        "pkg/volume/storageos/": true,
        "pkg/volume/cephfs/": true,
        "pkg/volume/glusterfs/": true,
        "pkg/volume/scaleio/": true,
        "pkg/volume/portworx/": true,
        "pkg/volume/fc/": true,
        "pkg/volume/flocker/": true,
        "pkg/volume/vsphere_volume": true,
        "pkg/windows/": true,
        "**/*_windows.go": true,
        "**/*_windows_test.go": true,
        "**/*_darwin.go": true,
        "**/*_darwin_test.go": true,
    },
    // 全局搜索不搜索如下目录内容
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,

        "**/BUILD": true,
        "**/OWNERS": true,
        "**/*.bzl": true,
        "cmd/cloud-controller-manager/": true,
        "cmd/kubemark/": true,
        "cmd/gendocs/": true,
        "cmd/genkubedocs/": true,
        "cmd/genman/": true,
        "cmd/genswaggertypedocs/": true,
        "cmd/genutils/": true,
        "cmd/genyaml/": true,
        "pkg/cloudprovider/": true,
        "pkg/kubemark/": true,
        "pkg/credentialprovider/aws": true,
        "pkg/credentialprovider/azure": true,
        "pkg/credentialprovider/gcp": true,
        "pkg/volume/cinder/": true,
        "pkg/volume/git_repo/": true,
        "pkg/volume/awsebs/": true,
        "pkg/volume/azure_dd/": true,
        "pkg/volume/azure_file/": true,
        "pkg/volume/gcepd/": true,
        "pkg/volume/rbd/": true,
        "pkg/volume/storageos/": true,
        "pkg/volume/cephfs/": true,
        "pkg/volume/glusterfs/": true,
        "pkg/volume/scaleio/": true,
        "pkg/volume/portworx/": true,
        "pkg/volume/fc/": true,
        "pkg/volume/flocker/": true,
        "pkg/volume/vsphere_volume": true,
        "pkg/windows/": true,
        "**/*_windows.go": true,
        "**/*_windows_test.go": true,
        "**/*_darwin.go": true,
        "**/*_darwin_test.go": true,
    }
}
