{
    // 1.16.2 需要 golang 1.12, 1.17.2 则需要 golang 1.13
    "version": "0.2.0",
    "configurations": [
        {
            "name": "apiserver",
            // 注意: golang 版本需要为 1.13, 然后执行 make generated_files, 否则启动会报错:
            // app/server.go:553:3: undefined: "k8s.io/kubernetes/pkg/generated/openapi".GetOpenAPIDefinitions (exit status 2)
            "type": "go", 
            "request": "launch",
            "mode": "auto",
            "env": {
                "GO111MODULE": "auto",
                "CGO_ENABLED": "0",
            },
            "program": "${workspaceFolder}/cmd/kube-apiserver/",
            // v1.16.0 版本 kube 集群, 启动参数借鉴
            // /etc/kubernetes/manifests/kube-apiserver.yaml
            "args": [
                "--insecure-port=0",
                "--secure-port=16443",              // 端口与内置的区分开
                "--advertise-address=192.168.42.10",

                "--service-cluster-ip-range=10.96.0.0/12",
                "--allow-privileged=true",
                "--authorization-mode=Node,RBAC",
                "--enable-admission-plugins=NodeRestriction",
                "--enable-bootstrap-token-auth=true",
                "--kubelet-preferred-address-types=InternalIP,ExternalIP,Hostname",
                // "--token-auth-file=/etc/kubernetes/pki/token_auth_file",

                "--etcd-cafile=/etc/kubernetes/pki/etcd/ca.crt",
                "--etcd-certfile=/etc/kubernetes/pki/apiserver-etcd-client.crt",
                "--etcd-keyfile=/etc/kubernetes/pki/apiserver-etcd-client.key",
                "--etcd-servers=https://127.0.0.1:2379",

                "--client-ca-file=/etc/kubernetes/pki/ca.crt",
                "--kubelet-client-certificate=/etc/kubernetes/pki/apiserver-kubelet-client.crt",
                "--kubelet-client-key=/etc/kubernetes/pki/apiserver-kubelet-client.key",
                "--proxy-client-cert-file=/etc/kubernetes/pki/front-proxy-client.crt",
                "--proxy-client-key-file=/etc/kubernetes/pki/front-proxy-client.key",
                "--tls-cert-file=/etc/kubernetes/pki/apiserver.crt",
                "--tls-private-key-file=/etc/kubernetes/pki/apiserver.key",
                "--service-account-key-file=/etc/kubernetes/pki/sa.pub",

                "--requestheader-allowed-names=front-proxy-client",
                "--requestheader-client-ca-file=/etc/kubernetes/pki/front-proxy-ca.crt",
                "--requestheader-extra-headers-prefix=X-Remote-Extra-",
                "--requestheader-group-headers=X-Remote-Group",
                "--requestheader-username-headers=X-Remote-User",
            ]
        },
        {
            "name": "controller-manager",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "env": {
                "GO111MODULE": "auto",
                "CGO_ENABLED": "0",
            },
            "program": "${workspaceFolder}/cmd/kube-controller-manager/",
            // v1.16.0 版本 kube 集群, /etc/kubernetes/manifests/kube-controller-manager.yaml
            // 文件中的参数列表拷贝过来的.
            "args": [
                "--bind-address=127.0.0.1",
                "--secure-port=11257", // 默认为 10257
                "--port=0", // 默认为 10252, 0为禁用

                "--leader-elect=false",
                "--authentication-kubeconfig=/etc/kubernetes/controller-manager.conf",
                "--authorization-kubeconfig=/etc/kubernetes/controller-manager.conf",

                "--cluster-cidr=10.254.0.0/16",
                "--node-cidr-mask-size=24",
                "--allocate-node-cidrs=true",
                "--service-cluster-ip-range=10.96.0.0/12",

                "--controllers=*,bootstrapsigner,tokencleaner",
                "--use-service-account-credentials=true",

                "--kubeconfig=/etc/kubernetes/controller-manager.conf",
                "--client-ca-file=/etc/kubernetes/pki/ca.crt",
                "--cluster-signing-cert-file=/etc/kubernetes/pki/ca.crt",
                "--cluster-signing-key-file=/etc/kubernetes/pki/ca.key",
                "--root-ca-file=/etc/kubernetes/pki/ca.crt",
                "--requestheader-client-ca-file=/etc/kubernetes/pki/front-proxy-ca.crt",
                "--service-account-private-key-file=/etc/kubernetes/pki/sa.key",
            ]
        },
        {
            "name": "kubelet",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/kubelet/",
            // v1.16.0 版本 kube 集群, 
            // 如下内容是由 "ps -ef | grep kubelet" 的启动参数拷贝过来的.
            "args": [
                "--port=11250", // 默认为 10250
                "--healthz-port=0", // 默认为10248, 0为禁用

                "--bootstrap-kubeconfig=/etc/kubernetes/bootstrap-kubelet.conf",
                "--kubeconfig=/etc/kubernetes/kubelet.conf",
                "--config=/var/lib/kubelet/config.yaml",
                "--cgroup-driver=systemd",
                "--network-plugin=cni",
                "--pod-infra-container-image=registry.cn-hangzhou.aliyuncs.com/google_containers/pause:3.1",
            ]
        },
        {
            "name": "proxy",
            "type": "go", 
            "request": "launch",
            "mode": "auto",
            "env": {
                "GO111MODULE": "auto",
                "CGO_ENABLED": "0",
            },
            "program": "${workspaceFolder}/cmd/kube-proxy/",
            "args": [
                "--config=${workspaceFolder}/.vscode/proxy/config.conf"
            ]
        },
        {
            "name": "kubeadm init",
            "type": "go", 
            "request": "launch",
            "mode": "auto",
            "env": {
                "GO111MODULE": "auto",
                "CGO_ENABLED": "0",
            },
            "program": "${workspaceFolder}/cmd/kubeadm/",
            "args": [
                "init",
                "--config", "${workspaceFolder}/.vscode/kubeadm/config.yaml",
            ]
        },
        {
            "name": "kubeadm join",
            "type": "go", 
            "request": "launch",
            "mode": "auto",
            "env": {
                "GO111MODULE": "auto",
                "CGO_ENABLED": "0",
            },
            "program": "${workspaceFolder}/cmd/kubeadm/",
            "args": [
                "join",
                "172.16.42.39:6443",
                "--token", "llhv2n.avh88zmjtz01xza4", // 这是 bootstrap token 的内容.
                "--discovery-token-ca-cert-hash",
                "sha256:04c2f16c91f9552acb950409a4f531f108ee4c86d7e1693c5a48a934943aff99",
                "--control-plane",
            ]
        },
    ]
}
